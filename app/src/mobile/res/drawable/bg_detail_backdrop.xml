<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页海报背景遮罩：顶部半透保留氛围，向下渐入深色沉浸底。
     详情页恒为深色底（玻璃卡片按深色底设计），endColor 固定深色，不随明暗主题变化，
     否则浅色主题下会渐入浅色页面底色导致下半部分发白。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#40101316"
        android:centerColor="#B3101316"
        android:endColor="#FF101316" />
</shape>
