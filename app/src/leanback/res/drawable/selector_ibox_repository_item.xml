<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_primary_container" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
            <corners android:radius="@dimen/ibox_radius_card" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_focus_surface" />
            <stroke
                android:width="@dimen/ibox_focus_stroke"
                android:color="?attr/focusFrameColor" />
            <corners android:radius="@dimen/ibox_radius_card" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_primary_container" />
            <corners android:radius="@dimen/ibox_radius_card" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_surface_container_high" />
            <corners android:radius="@dimen/ibox_radius_card" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
