<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/repositoryItem"
    style="@style/Widget.IBox.RepositoryItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:nextFocusRight="@id/selected">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ibox_space_2"
        android:duplicateParentState="true"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.IBox.ItemTitle"
        android:textColor="@color/ibox_text_primary"
        app:layout_constraintEnd_toStartOf="@id/selected"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/selected"
        style="@style/Widget.IBox.IconButton"
        android:layout_width="@dimen/ibox_touch_target"
        android:layout_height="@dimen/ibox_touch_target"
        android:background="@drawable/selector_icon_action"
        android:contentDescription="@string/setting_choose"
        android:nextFocusLeft="@id/repositoryItem"
        android:nextFocusRight="@id/edit"
        android:src="@drawable/ic_msr_radio_button_unchecked"
        android:tooltipText="@string/setting_choose"
        app:layout_constraintEnd_toStartOf="@id/edit"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/selector_repository_select_icon" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/edit"
        style="@style/Widget.IBox.IconButton"
        android:layout_width="@dimen/ibox_touch_target"
        android:layout_height="@dimen/ibox_touch_target"
        android:background="@drawable/selector_icon_action"
        android:contentDescription="@string/repository_edit"
        android:nextFocusLeft="@id/selected"
        android:nextFocusRight="@id/delete"
        android:src="@drawable/ic_msr_edit"
        android:tooltipText="@string/repository_edit"
        app:layout_constraintEnd_toStartOf="@id/delete"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ibox_text_secondary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/delete"
        style="@style/Widget.IBox.IconButton"
        android:layout_width="@dimen/ibox_touch_target"
        android:layout_height="@dimen/ibox_touch_target"
        android:background="@drawable/selector_icon_action"
        android:contentDescription="@string/accessibility_delete"
        android:nextFocusLeft="@id/edit"
        android:src="@drawable/ic_msr_delete"
        android:tooltipText="@string/accessibility_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ibox_text_secondary" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="name,selected,edit,delete" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ibox_space_1"
        android:breakStrategy="simple"
        android:duplicateParentState="true"
        android:ellipsize="middle"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.IBox.Supporting"
        android:textColor="@color/ibox_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBottom" />

</androidx.constraintlayout.widget.ConstraintLayout>
