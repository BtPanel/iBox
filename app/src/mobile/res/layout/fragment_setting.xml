<?xml version="1.0" encoding="utf-8"?>
<!--
  设置首页：只做「入口」，不再把二十多个开关平铺在一页。
  五类设置各自进二级页面，主页保持一屏以内可读完。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.IBox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_toolbar_height"
        app:title="@string/nav_setting" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ibox_content_padding_horizontal"
            android:paddingTop="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_content_padding_horizontal"
            android:paddingBottom="@dimen/ibox_navigation_content_padding">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowSource"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowGeneral"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowAppearance"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowPlayback"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowData"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_about"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowVersion"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
