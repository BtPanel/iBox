<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/ibox_text_primary"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/copy"
        android:layout_width="@dimen/ibox_touch_target"
        android:layout_height="@dimen/ibox_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/live_epg_copy"
        android:padding="10dp"
        android:src="@drawable/ic_epg_copy"
        app:tint="@color/ibox_text_primary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/delete"
        android:layout_width="@dimen/ibox_touch_target"
        android:layout_height="@dimen/ibox_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/live_epg_delete"
        android:padding="10dp"
        android:src="@drawable/ic_msr_delete"
        app:tint="@color/ibox_text_primary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/activate"
        android:layout_width="@dimen/ibox_touch_target"
        android:layout_height="@dimen/ibox_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/live_epg_activate"
        android:padding="10dp"
        android:src="@drawable/ic_epg_activate"
        app:tint="@color/ibox_text_primary" />
</androidx.appcompat.widget.LinearLayoutCompat>
