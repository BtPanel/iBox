<?xml version="1.0" encoding="utf-8"?>
<!--
  页面顶部可读性遮罩：顶部用实体表面色，向下渐隐到透明。
  换壁纸后保证 toolbar / tabs / summary 等顶部文字始终有实底衬托，
  同时下方内容区照常透出壁纸，不产生「顶栏纯色 / 内容壁纸」的横向硬边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:centerColor="@color/ibox_home_scrim_soft"
        android:centerY="0.35"
        android:endColor="@color/ibox_home_scrim_clear"
        android:startColor="@color/ibox_home_scrim_soft"
        android:type="linear" />

</shape>
