<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@android:color/transparent"
        app:menu="@menu/menu_history"
        app:navigationIconTint="@color/ibox_text_primary"
        app:title="@string/app_history"
        app:titleTextAppearance="@style/ToolbarTextAppearance" />

    <com.imedia.box.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp"
            tools:listitem="@layout/adapter_vod" />

    </com.imedia.box.ui.custom.ProgressLayout>

    <include
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_navigation_height"
        layout="@layout/view_app_navigation" />
</androidx.appcompat.widget.LinearLayoutCompat>
