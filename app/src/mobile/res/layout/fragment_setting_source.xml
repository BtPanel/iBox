<?xml version="1.0" encoding="utf-8"?>
<!-- 二级页：内容源（点播 / 直播 / 壁纸） -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.IBox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_toolbar_height"
        app:title="@string/setting_entry_source" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ibox_content_padding_horizontal"
            android:paddingTop="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_content_padding_horizontal"
            android:paddingBottom="@dimen/ibox_navigation_content_padding">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/setting_source_tip"
                android:textColor="@color/ibox_text_secondary"
                android:textSize="@dimen/ibox_text_caption" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/vod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ibox_setting_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ibox_space_4"
                    android:paddingTop="@dimen/ibox_space_3"
                    android:paddingEnd="@dimen/ibox_space_2"
                    android:paddingBottom="@dimen/ibox_space_3">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_msr_movie"
                        app:tint="@color/ibox_text_secondary" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_vod"
                            android:textColor="@color/ibox_text_primary"
                            android:textSize="@dimen/ibox_text_body" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/vodUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/ibox_text_secondary"
                            android:textSize="@dimen/ibox_text_supporting"
                            tools:text="https://example.com/config.json" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/vodHome"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/nav_home"
                        android:padding="10dp"
                        android:src="@drawable/ic_msr_home"
                        app:tint="@color/ibox_text_secondary" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/vodHistory"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/repository_vod_title"
                        android:padding="10dp"
                        android:src="@drawable/ic_msr_rss_feed"
                        app:tint="@color/ibox_text_secondary" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/ibox_icon_small"
                        android:layout_height="@dimen/ibox_icon_small"
                        android:layout_marginStart="@dimen/ibox_space_1"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_msr_chevron_right"
                        app:tint="@color/ibox_text_secondary" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ibox_setting_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ibox_space_4"
                    android:paddingTop="@dimen/ibox_space_3"
                    android:paddingEnd="@dimen/ibox_space_2"
                    android:paddingBottom="@dimen/ibox_space_3">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_msr_live_tv"
                        app:tint="@color/ibox_text_secondary" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_live"
                            android:textColor="@color/ibox_text_primary"
                            android:textSize="@dimen/ibox_text_body" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/liveUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/ibox_text_secondary"
                            android:textSize="@dimen/ibox_text_supporting"
                            tools:text="https://example.com/live.m3u" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/liveHome"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/nav_home"
                        android:padding="10dp"
                        android:src="@drawable/ic_msr_home"
                        app:tint="@color/ibox_text_secondary" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/liveHistory"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/repository_live_title"
                        android:padding="10dp"
                        android:src="@drawable/ic_msr_rss_feed"
                        app:tint="@color/ibox_text_secondary" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/ibox_icon_small"
                        android:layout_height="@dimen/ibox_icon_small"
                        android:layout_marginStart="@dimen/ibox_space_1"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_msr_chevron_right"
                        app:tint="@color/ibox_text_secondary" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowWall"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
