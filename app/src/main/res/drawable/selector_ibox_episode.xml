<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
            <corners android:radius="@dimen/ibox_radius_small" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_player_control_surface_focused" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
            <corners android:radius="@dimen/ibox_radius_small" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_player_control_surface_focused" />
            <stroke android:width="@dimen/ibox_stroke_thin" android:color="@color/ibox_player_text_primary" />
            <corners android:radius="@dimen/ibox_radius_small" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/colorOnPrimary" />
            <corners android:radius="@dimen/ibox_radius_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_player_control_surface" />
            <stroke android:width="@dimen/ibox_stroke_thin" android:color="@color/ibox_player_control_outline" />
            <corners android:radius="@dimen/ibox_radius_small" />
        </shape>
    </item>
</selector>
