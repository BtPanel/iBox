<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:layout_margin="2dp"
    android:background="@drawable/bg_search_result"
    android:foreground="@drawable/shape_vod">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="78dp"
        android:layout_height="match_parent"
        android:background="@color/ibox_surface_variant"
        app:shapeAppearanceOverlay="@style/Vod.Grid.Large" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_vod_site"
        android:ellipsize="end"
        android:maxWidth="78dp"
        android:singleLine="true"
        android:textColor="@color/text_site"
        android:textSize="@dimen/ibox_text_supporting"
        android:visibility="gone"
        tools:text="泥巴"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/shape_vod_year"
        android:singleLine="true"
        android:textColor="@color/text_site"
        android:textSize="@dimen/ibox_text_supporting"
        android:visibility="gone"
        tools:text="2024"
        tools:visibility="visible" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/image"
        android:orientation="vertical"
        android:padding="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ibox_text_primary"
            android:textSize="@dimen/ibox_text_supporting"
            tools:text="蜘蛛人" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:textColor="@color/ibox_text_secondary"
            android:textSize="@dimen/ibox_text_supporting"
            tools:text="1080p" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
