<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ibox_touch_target"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/ibox_space_2"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.IBox.DialogTitle"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_positive"
            style="@style/Widget.IBox.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ibox_touch_target"
            android:minWidth="@dimen/ibox_touch_target"
            android:paddingStart="@dimen/ibox_space_3"
            android:paddingEnd="@dimen/ibox_space_3"
            android:text="@string/dialog_positive"
            android:textAppearance="@style/TextAppearance.IBox.Body"
            android:visibility="gone" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
