<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingWindow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_player"
    android:clipToOutline="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/floatingPlayer"
        style="@style/Player.Vod"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="none"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/floatingControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ibox_player_scrim_soft"
        android:clickable="true">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/floatingSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/setting_player"
            android:padding="10dp"
            android:src="@drawable/ic_msr_settings"
            app:tint="@color/ibox_player_text_primary" />

        <LinearLayout
            android:id="@+id/floatingTopActions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="end|top"
            android:orientation="horizontal"
            android:paddingEnd="4dp"
            android:paddingTop="4dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/floatingFullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/floating_player_fullscreen"
                android:padding="10dp"
                android:src="@drawable/ic_msr_fullscreen"
                app:tint="@color/ibox_player_text_primary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/floatingClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/floating_player_close"
                android:padding="10dp"
                android:src="@drawable/ic_msr_close"
                app:tint="@color/ibox_player_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/floatingPlaybackActions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/floatingPrevious"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play_prev"
                android:padding="12dp"
                android:src="@drawable/ic_msr_skip_previous"
                app:tint="@color/ibox_player_text_primary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/floatingPlayPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pause"
                android:padding="12dp"
                android:src="@drawable/ic_msr_pause"
                app:tint="@color/ibox_player_text_primary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/floatingNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play_next"
                android:padding="12dp"
                android:src="@drawable/ic_msr_skip_next"
                app:tint="@color/ibox_player_text_primary" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/floatingSeek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:max="10000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="@color/ibox_player_control_outline"
            android:progressTint="?attr/colorPrimary"
            android:thumbOffset="0dp"
            android:thumbTint="?attr/colorPrimary" />
    </FrameLayout>
</FrameLayout>
