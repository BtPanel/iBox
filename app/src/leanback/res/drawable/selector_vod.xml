<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <stroke android:width="@dimen/ibox_focus_halo_stroke" android:color="@color/ibox_surface_container" />
                    <corners android:radius="@dimen/ibox_radius_card" />
                </shape>
            </item>
            <item
                android:left="@dimen/ibox_stroke_thin"
                android:top="@dimen/ibox_stroke_thin"
                android:right="@dimen/ibox_stroke_thin"
                android:bottom="@dimen/ibox_stroke_thin">
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
                    <corners android:radius="@dimen/ibox_radius_card" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@color/transparent" />
</selector>
