<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_home_surface_strong" />
            <corners android:radius="@dimen/ibox_radius_small" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_home_surface_focused" />
            <corners android:radius="@dimen/ibox_radius_small" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_home_surface" />
            <corners android:radius="@dimen/ibox_radius_small" />
            <stroke android:width="2dp" android:color="@color/tv_home_outline" />
        </shape>
    </item>
</selector>
