<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ibox_home_poster_margin"
    android:layout_marginTop="@dimen/ibox_space_1"
    android:layout_marginBottom="@dimen/ibox_space_3"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/shape_vod"
    android:orientation="vertical"
    android:stateListAnimator="@animator/vod_press">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/ibox_surface_variant"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Vod.Grid.Large" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="@dimen/ibox_space_1"
            android:background="@drawable/bg_home_poster_badge"
            android:ellipsize="end"
            android:maxWidth="72dp"
            android:paddingStart="@dimen/ibox_space_2"
            android:paddingTop="1dp"
            android:paddingEnd="@dimen/ibox_space_2"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.IBox.PosterBadge"
            android:visibility="gone"
            tools:text="泥巴"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="@dimen/ibox_space_1"
            android:background="@drawable/bg_home_poster_badge"
            android:ellipsize="end"
            android:maxWidth="72dp"
            android:paddingStart="@dimen/ibox_space_2"
            android:paddingTop="1dp"
            android:paddingEnd="@dimen/ibox_space_2"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.IBox.PosterBadge"
            android:visibility="gone"
            tools:text="2022"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remarkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/ibox_vod_name_height"
            android:background="@drawable/shape_vod_score"
            android:ellipsize="end"
            android:maxWidth="96dp"
            android:paddingStart="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_space_2"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.IBox.Supporting"
            android:textColor="@color/white"
            android:visibility="gone"
            tools:text="8.5"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            style="@style/Widget.IBox.PosterTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ibox_vod_name_height"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_vod_name"
            android:paddingStart="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_space_2"
            tools:text="越剧《劈山救母》" />

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
