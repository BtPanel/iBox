<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IBox.Mobile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="focusFrameColor">@color/ibox_focus</item>
        <item name="focusContentColor">@color/ibox_text_primary</item>
        <item name="colorPrimary">@color/ibox_primary</item>
        <item name="colorOnPrimary">@color/ibox_on_primary</item>
        <item name="colorPrimaryContainer">@color/ibox_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ibox_on_primary_container</item>
        <item name="colorSecondary">@color/ibox_secondary</item>
        <item name="colorOnSecondary">@color/ibox_surface</item>
        <item name="colorSecondaryContainer">@color/ibox_surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/ibox_text_primary</item>
        <item name="colorSurface">@color/ibox_surface</item>
        <item name="colorSurfaceVariant">@color/ibox_surface_variant</item>
        <item name="colorOnSurface">@color/ibox_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ibox_text_secondary</item>
        <item name="colorOutline">@color/ibox_outline</item>
        <item name="colorOutlineVariant">@color/ibox_divider</item>
        <item name="colorError">@color/ibox_error</item>
        <item name="colorErrorContainer">@color/ibox_error_container</item>
        <item name="colorOnErrorContainer">@color/ibox_on_error_container</item>
        <item name="materialSwitchStyle">@style/Widget.IBox.MaterialSwitch</item>
        <item name="materialButtonStyle">@style/Widget.IBox.Button</item>
        <item name="materialCardViewStyle">@style/Widget.IBox.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.IBox.Dialog.Alert</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.IBox.Dialog.BottomSheet</item>
        <item name="android:colorAccent">@color/ibox_primary</item>
        <item name="android:colorControlHighlight">@color/ibox_navigation_item</item>
        <item name="android:windowBackground">@color/ibox_surface_container</item>
    </style>

    <style name="Theme.IBox.TV" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="focusFrameColor">@color/ibox_focus</item>
        <item name="focusContentColor">@color/ibox_on_primary</item>
        <item name="colorPrimary">@color/ibox_primary</item>
        <item name="colorOnPrimary">@color/ibox_on_primary</item>
        <item name="colorPrimaryContainer">@color/ibox_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ibox_on_primary_container</item>
        <item name="colorSecondary">@color/ibox_secondary</item>
        <item name="colorSurface">@color/ibox_surface</item>
        <item name="colorSurfaceVariant">@color/ibox_surface_variant</item>
        <item name="colorSurfaceDim">@color/ibox_surface_container_low</item>
        <item name="colorSurfaceBright">@color/ibox_surface_container_high</item>
        <item name="colorSurfaceContainerLowest">@color/ibox_surface_container_low</item>
        <item name="colorSurfaceContainerLow">@color/ibox_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/ibox_surface</item>
        <item name="colorSurfaceContainerHigh">@color/ibox_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/ibox_surface_container_high</item>
        <item name="colorOnSurface">@color/ibox_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ibox_text_secondary</item>
        <item name="colorOutline">@color/ibox_outline</item>
        <item name="colorOutlineVariant">@color/ibox_divider</item>
        <item name="colorError">@color/ibox_error</item>
        <item name="colorErrorContainer">@color/ibox_error_container</item>
        <item name="colorOnErrorContainer">@color/ibox_on_error_container</item>
        <item name="materialSwitchStyle">@style/Widget.IBox.MaterialSwitch</item>
        <item name="materialButtonStyle">@style/Widget.IBox.Button</item>
        <item name="materialCardViewStyle">@style/Widget.IBox.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.IBox.Dialog.Alert</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.IBox.Dialog.BottomSheet</item>
        <item name="android:colorControlHighlight">@color/white_15</item>
        <item name="android:windowBackground">@color/ibox_surface_container</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="TextAppearance.IBox.PageTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/ibox_text_page_title</item>
    </style>

    <style name="TextAppearance.IBox.DialogTitle" parent="TextAppearance.IBox.PageTitle">
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/ibox_text_dialog_title</item>
    </style>

    <style name="TextAppearance.IBox.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.IBox.Toolbar" parent="TextAppearance.IBox.PageTitle">
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.IBox.ItemTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/ibox_text_item_title</item>
    </style>

    <style name="ShapeAppearance.IBox.DownloadPoster" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ibox_radius_card</item>
    </style>

    <style name="TextAppearance.IBox.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/ibox_text_body</item>
    </style>

    <style name="TextAppearance.IBox.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">@dimen/ibox_text_supporting</item>
    </style>

    <style name="TextAppearance.IBox.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">@dimen/ibox_text_label</item>
    </style>

    <style name="TextAppearance.IBox.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/ibox_text_button</item>
    </style>

    <style name="TextAppearance.IBox.Address" parent="TextAppearance.IBox.Body">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/ibox_text_address</item>
    </style>

    <style name="TextAppearance.IBox.PosterTitle" parent="TextAppearance.IBox.ItemTitle">
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/ibox_text_poster</item>
    </style>

    <style name="TextAppearance.IBox.Error" parent="TextAppearance.IBox.Supporting">
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ibox_error</item>
    </style>

    <style name="TextAppearance.IBox.PlayerTitle" parent="TextAppearance.IBox.PageTitle">
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ibox_player_text_primary</item>
        <item name="android:textSize">@dimen/ibox_text_dialog_title</item>
    </style>

    <style name="TextAppearance.IBox.PlayerSection" parent="TextAppearance.IBox.Section">
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ibox_player_text_primary</item>
    </style>

    <style name="TextAppearance.IBox.PlayerBody" parent="TextAppearance.IBox.Body">
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ibox_player_text_secondary</item>
    </style>

    <style name="TextAppearance.IBox.PlayerSupporting" parent="TextAppearance.IBox.Supporting">
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ibox_player_text_secondary</item>
    </style>

    <style name="TextAppearance.IBox.PlayerAccent" parent="TextAppearance.IBox.Supporting">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ibox_episode_selected_text</item>
    </style>

    <style name="ShapeAppearance.IBox.Component" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/ibox_radius_small</item>
    </style>

    <style name="ShapeAppearance.IBox.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/ibox_radius_card</item>
    </style>

    <style name="ShapeAppearance.IBox.Container" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/ibox_radius_container</item>
    </style>

    <style name="Widget.IBox.Button.Base" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.IBox.Card</item>
        <item name="android:minHeight">@dimen/ibox_touch_target</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ibox_text_button</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">@dimen/ibox_text_button</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="Widget.IBox.Button" parent="Widget.IBox.Button.Base" />

    <style name="Widget.IBox.Button.Primary" parent="Widget.IBox.Button" />

    <style name="Widget.IBox.Button.Tonal" parent="Widget.IBox.Button.Base">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- 弹窗确认键：操作组里唯一的强调项，取消等次级动作保持默认文字样式 -->
    <style name="Widget.IBox.Dialog.PositiveButton" parent="Widget.IBox.Button.Tonal" />

    <style name="Widget.IBox.Button.Outlined" parent="Widget.IBox.Button.Base">
        <item name="backgroundTint">@color/selector_ibox_button_outline_background</item>
        <item name="strokeColor">@color/selector_ibox_component_outline</item>
        <item name="strokeWidth">@dimen/ibox_stroke_thin</item>
        <item name="android:textColor">@color/selector_ibox_component_action</item>
        <item name="iconTint">@color/selector_ibox_component_action</item>
    </style>

    <style name="Widget.IBox.Button.Text" parent="Widget.IBox.Button.Base">
        <item name="android:minWidth">@dimen/ibox_touch_target</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/selector_ibox_component_action</item>
        <item name="iconTint">@color/selector_ibox_component_action</item>
    </style>

    <style name="Widget.IBox.Button.Danger" parent="Widget.IBox.Button.Text">
        <item name="android:textColor">@color/ibox_error</item>
        <item name="iconTint">@color/ibox_error</item>
    </style>

    <style name="Widget.IBox.Button.Segment" parent="Widget.IBox.Button.Outlined">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.IBox.Button.IconOnly" parent="Widget.IBox.Button.Tonal">
        <item name="android:minWidth">@dimen/ibox_icon_action_size</item>
        <item name="android:minHeight">@dimen/ibox_icon_action_size</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/ibox_icon_medium</item>
    </style>

    <style name="Widget.IBox.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.IBox.Component</item>
        <item name="cardBackgroundColor">@color/ibox_surface</item>
        <item name="strokeColor">@color/ibox_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.IBox.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:scaleX">0.78</item>
        <item name="android:scaleY">0.78</item>
        <item name="thumbIcon">@null</item>
        <item name="thumbTint">@color/selector_ibox_switch_thumb</item>
        <item name="trackDecoration">@null</item>
        <item name="trackTint">@color/selector_ibox_switch_track</item>
    </style>
</resources>
