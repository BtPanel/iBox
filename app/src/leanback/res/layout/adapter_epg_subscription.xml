<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/selector_dialog_button"
        android:ellipsize="middle"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/selector_dialog_button_text"
        android:textSize="@dimen/ibox_text_address"
        tools:text="[XML] 央视节目单" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/copy"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="@drawable/selector_dialog_button"
        android:contentDescription="@string/live_epg_copy"
        android:padding="12dp"
        android:src="@drawable/ic_epg_copy"
        android:tint="@color/selector_dialog_button_text" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/delete"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="@drawable/selector_dialog_button"
        android:contentDescription="@string/live_epg_delete"
        android:padding="12dp"
        android:src="@drawable/ic_msr_delete"
        android:tint="@color/selector_dialog_button_text" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/activate"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="@drawable/selector_dialog_button"
        android:contentDescription="@string/live_epg_activate"
        android:padding="12dp"
        android:src="@drawable/ic_epg_activate"
        android:tint="@color/selector_dialog_button_text" />
</androidx.appcompat.widget.LinearLayoutCompat>
