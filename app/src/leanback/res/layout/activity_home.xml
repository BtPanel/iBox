<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.28"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_home_scrim" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_toolbar_height"
        android:animateLayoutChanges="true"
        android:background="@color/ibox_surface_container"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tv_page_padding_horizontal"
        android:paddingEnd="@dimen/tv_page_padding_horizontal"
        android:paddingTop="@dimen/ibox_space_2">

        <com.imedia.box.ui.custom.CustomTitleView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ibox_touch_target"
            android:layout_marginEnd="@dimen/ibox_space_4"
            android:background="@drawable/selector_home_title"
            android:ellipsize="end"
            android:focusable="false"
            android:gravity="center_vertical"
            android:maxWidth="780dp"
            android:singleLine="true"
            android:text="@string/app_name"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ibox_text_primary"
            android:textSize="@dimen/ibox_text_page_title" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ibox_touch_target"
            android:background="@color/transparent"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="@color/ibox_text_secondary"
            android:textSize="@dimen/ibox_text_body"
            tools:text="2026年08月25日 17:15:42" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.imedia.box.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/tv_page_padding_horizontal"
            android:paddingTop="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/tv_page_padding_horizontal"
            android:paddingBottom="@dimen/tv_page_padding_bottom"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.imedia.box.ui.custom.ProgressLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
