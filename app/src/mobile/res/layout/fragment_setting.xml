<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：单页平铺，去掉二级菜单。
  按分组标题区分，所有开关/选择项直接列在这一页，一屏内滚动可达。
  「播放器」「弹幕」设置项较多，仍保留为独立页面入口。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.IBox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_toolbar_height"
        app:title="@string/nav_setting" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ibox_content_padding_horizontal"
            android:paddingTop="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_content_padding_horizontal"
            android:paddingBottom="@dimen/ibox_navigation_content_padding">

            <!-- ============ 内容源 ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_sources"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/vod"
                    layout="@layout/view_setting_source_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/live"
                    layout="@layout/view_setting_source_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowWall"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============ 通用 ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_general"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowIncognito"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowConfigNotice"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowRemoteAccess"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowHideNavigation"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowFloatingNavigation"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowResumeButton"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowBootAutoStart"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============ 外观 ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_appearance"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowThemeMode"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowLayoutMode"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowThemeColor"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowHomeContent"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowSize"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowAccessibility"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============ 播放与弹幕 ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_playback"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowPlayer"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowDanmaku"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowAutoFallbackLine"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowAutoFallbackSource"
                    layout="@layout/view_setting_switch_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============ 网络与数据 ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_data"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowGithubAcceleration"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:id="@+id/dividerGithubAccelerators"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowGithubAccelerators"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowDoh"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowSearchThreads"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowSourceHealth"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowCache"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowWebdav"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowBackup"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowRestore"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============ 关于 ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_about"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowVersion"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
