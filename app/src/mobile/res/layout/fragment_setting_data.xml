<?xml version="1.0" encoding="utf-8"?>
<!-- 二级页：网络与数据（加速/DoH/线程/健康检查，以及缓存、同步、备份、恢复） -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.IBox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_toolbar_height"
        app:title="@string/setting_entry_data" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ibox_content_padding_horizontal"
            android:paddingTop="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_content_padding_horizontal"
            android:paddingBottom="@dimen/ibox_navigation_content_padding">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_network"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowGithubAcceleration"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowGithubAccelerators"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowDoh"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowSearchThreads"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowSourceHealth"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_5"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/settings_section_storage"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_group"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowCache"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowWebdav"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowBackup"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="52dp"
                    android:background="@color/ibox_glass_divider" />

                <include
                    android:id="@+id/rowRestore"
                    layout="@layout/view_setting_row" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
