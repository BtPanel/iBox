<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ibox_space_5"
        android:paddingTop="@dimen/ibox_space_5"
        android:paddingEnd="@dimen/ibox_space_5"
        android:paddingBottom="@dimen/ibox_space_6">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ibox_text_primary"
            android:textAppearance="@style/ToolbarTextAppearance" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_space_1"
            android:textColor="@color/ibox_text_secondary"
            android:textSize="@dimen/ibox_text_supporting"
            tools:text="v5.6.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_space_5"
            android:layout_marginBottom="@dimen/ibox_space_2"
            android:text="@string/mine_common"
            android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IBox.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:padding="@dimen/ibox_space_1"
                android:rowCount="4">

                <LinearLayout
                    android:id="@+id/subscription"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_subscriptions" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/mine_subscription" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/searchThreads"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_search" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/mine_search_threads" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                    <TextView android:id="@+id/searchThreadsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_1" android:textColor="@color/ibox_text_secondary" android:textSize="@dimen/ibox_text_supporting" tools:text="5 线程" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wallpaper"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_folder" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/mine_wallpaper" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/theme"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_settings" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/mine_theme_mode" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/localVideo"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_video_library" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/mine_local_video" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playLink"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_link" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/mine_play_link" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/offlineLibrary"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/ibox_space_1"
                    android:background="@drawable/bg_mine_tile_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/ibox_icon_large" android:layout_height="@dimen/ibox_icon_large" android:contentDescription="@null" android:src="@drawable/ic_msr_download" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ibox_space_2" android:text="@string/offline_library" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_supporting" />
                </LinearLayout>
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_space_5"
            android:layout_marginBottom="@dimen/ibox_space_2"
            android:text="@string/mine_connect"
            android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IBox.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/tvControl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ibox_setting_row_height"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ibox_space_3"
                android:paddingEnd="@dimen/ibox_space_3">
                <ImageView android:layout_width="@dimen/ibox_icon_medium" android:layout_height="@dimen/ibox_icon_medium" android:contentDescription="@null" android:src="@drawable/ic_msr_tv" app:tint="?attr/colorPrimary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ibox_space_4" android:layout_weight="1" android:text="@string/mine_tv_control" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_body" />
                <ImageView android:layout_width="@dimen/ibox_icon_small" android:layout_height="@dimen/ibox_icon_small" android:contentDescription="@null" android:src="@drawable/ic_msr_chevron_right" app:tint="@color/ibox_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_space_5"
            android:layout_marginBottom="@dimen/ibox_space_2"
            android:text="@string/mine_more"
            android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IBox.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_setting_row_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ibox_space_3"
                    android:paddingEnd="@dimen/ibox_space_3">
                    <ImageView android:layout_width="@dimen/ibox_icon_medium" android:layout_height="@dimen/ibox_icon_medium" android:contentDescription="@null" android:src="@drawable/ic_msr_settings" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ibox_space_4" android:layout_weight="1" android:text="@string/nav_setting" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_body" />
                    <ImageView android:layout_width="@dimen/ibox_icon_small" android:layout_height="@dimen/ibox_icon_small" android:contentDescription="@null" android:src="@drawable/ic_msr_chevron_right" app:tint="@color/ibox_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="@dimen/ibox_space_5"
                    android:background="@color/ibox_glass_divider" />

                <LinearLayout
                    android:id="@+id/useMode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_setting_row_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ibox_space_3"
                    android:paddingEnd="@dimen/ibox_space_3">
                    <ImageView android:layout_width="@dimen/ibox_icon_medium" android:layout_height="@dimen/ibox_icon_medium" android:contentDescription="@null" android:src="@drawable/ic_msr_smartphone" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ibox_space_4" android:layout_weight="1" android:text="@string/mine_use_mode" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_body" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/ibox_space_2" android:text="@string/mine_phone_mode" android:textColor="@color/ibox_text_secondary" android:textSize="@dimen/ibox_text_supporting" />
                    <ImageView android:layout_width="@dimen/ibox_icon_small" android:layout_height="@dimen/ibox_icon_small" android:contentDescription="@null" android:src="@drawable/ic_msr_chevron_right" app:tint="@color/ibox_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="@dimen/ibox_space_5"
                    android:background="@color/ibox_glass_divider" />

                <LinearLayout
                    android:id="@+id/official"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_setting_row_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ibox_space_3"
                    android:paddingEnd="@dimen/ibox_space_3">
                    <ImageView android:layout_width="@dimen/ibox_icon_medium" android:layout_height="@dimen/ibox_icon_medium" android:contentDescription="@null" android:src="@drawable/ic_msr_verified" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ibox_space_4" android:layout_weight="1" android:text="@string/mine_official_channel" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_body" />
                    <ImageView android:layout_width="@dimen/ibox_icon_small" android:layout_height="@dimen/ibox_icon_small" android:contentDescription="@null" android:src="@drawable/ic_msr_chevron_right" app:tint="@color/ibox_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_stroke_thin"
                    android:layout_marginStart="@dimen/ibox_space_5"
                    android:background="@color/ibox_glass_divider" />

                <LinearLayout
                    android:id="@+id/about"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ibox_setting_row_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ibox_space_3"
                    android:paddingEnd="@dimen/ibox_space_3">
                    <ImageView android:layout_width="@dimen/ibox_icon_medium" android:layout_height="@dimen/ibox_icon_medium" android:contentDescription="@null" android:src="@drawable/ic_msr_info" app:tint="?attr/colorPrimary" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ibox_space_4" android:layout_weight="1" android:text="@string/mine_about" android:textColor="@color/ibox_text_primary" android:textSize="@dimen/ibox_text_body" />
                    <ImageView android:layout_width="@dimen/ibox_icon_small" android:layout_height="@dimen/ibox_icon_small" android:contentDescription="@null" android:src="@drawable/ic_msr_chevron_right" app:tint="@color/ibox_text_secondary" />
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
