<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_config"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/ibox_dialog_content_padding">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_touch_target"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/ibox_icon_large"
            android:layout_height="@dimen/ibox_icon_large"
            android:contentDescription="@null"
            android:src="@drawable/ic_msr_subscriptions"
            app:tint="?attr/colorPrimary" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ibox_space_3"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.IBox.DialogTitle" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/add"
            style="@style/Widget.IBox.IconButton"
            android:layout_width="@dimen/ibox_touch_target"
            android:layout_height="@dimen/ibox_touch_target"
            android:contentDescription="@string/repository_add"
            android:src="@drawable/ic_msr_add"
            android:tooltipText="@string/repository_add" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/repositoryType"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_touch_target"
        android:layout_marginTop="@dimen/ibox_dialog_group_spacing"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vod"
            style="@style/Widget.IBox.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/repository_vod" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/live"
            style="@style/Widget.IBox.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/repository_live" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ibox_dialog_group_spacing"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:minHeight="@dimen/ibox_repository_empty_min_height">

        <com.imedia.box.ui.custom.CustomRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/ibox_focus_stroke"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:maxHeight="@dimen/ibox_repository_list_max_height" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:alpha="0.72"
                android:contentDescription="@null"
                android:src="@drawable/ic_msr_subscriptions"
                app:tint="@color/ibox_text_secondary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ibox_space_3"
                android:textAppearance="@style/TextAppearance.IBox.Body" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
