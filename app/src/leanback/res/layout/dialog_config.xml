<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_config"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/ibox_dialog_content_padding">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/code"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:contentDescription="@string/home_push"
            android:focusable="true"
            android:foreground="@drawable/selector_qr_code"
            android:nextFocusRight="@id/name"
            android:padding="@dimen/ibox_space_1"
            android:scaleType="fitXY" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_dialog_group_spacing"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/ibox_space_1"
            android:maxLines="4"
            android:textAppearance="@style/TextAppearance.IBox.Supporting"
            tools:text="@string/push_info" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ibox_dialog_group_spacing"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.IBox.DialogTitle"
            tools:text="添加点播订阅" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_dialog_group_spacing"
            android:layout_marginBottom="@dimen/ibox_space_1"
            android:text="@string/repository_source_name"
            android:textAppearance="@style/TextAppearance.IBox.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.IBox.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false">

            <com.media.ibox.ui.custom.CustomEditText
                android:id="@+id/name"
                style="@style/Widget.IBox.TextInputEditText.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="40"
                android:minHeight="@dimen/ibox_touch_target"
                android:nextFocusDown="@id/text"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ibox_dialog_group_spacing"
            android:layout_marginBottom="@dimen/ibox_space_1"
            android:text="@string/repository_source_address"
            android:textAppearance="@style/TextAppearance.IBox.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.IBox.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false">

            <com.media.ibox.ui.custom.CustomEditText
                android:id="@+id/text"
                style="@style/Widget.IBox.TextInputEditText.Address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:nextFocusDown="@id/choose"
                android:nextFocusUp="@id/name"
                android:scrollHorizontally="true"
                android:textSize="@dimen/ibox_text_body"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ibox_touch_target"
            android:layout_marginTop="@dimen/ibox_dialog_group_spacing"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/choose"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/ibox_space_2"
                android:layout_weight="1"
                android:nextFocusRight="@id/positive"
                android:nextFocusUp="@id/text"
                android:text="@string/setting_choose" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/positive"
                style="@style/Widget.IBox.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/ibox_space_2"
                android:layout_weight="1"
                android:nextFocusLeft="@id/choose"
                android:nextFocusRight="@id/negative"
                android:nextFocusUp="@id/text"
                android:text="@string/dialog_positive" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/negative"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:nextFocusLeft="@id/positive"
                android:nextFocusUp="@id/text"
                android:text="@string/dialog_negative" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
