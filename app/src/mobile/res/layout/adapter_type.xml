<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ibox_home_tab_height"
    android:background="@drawable/bg_home_icon_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/ibox_home_tab_padding"
    android:paddingEnd="@dimen/ibox_home_tab_padding">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.IBox.HomeTab"
        tools:text="电影" />

    <View
        android:id="@+id/indicator"
        android:layout_width="@dimen/ibox_home_tab_indicator_width"
        android:layout_height="@dimen/ibox_home_tab_indicator_height"
        android:layout_marginTop="@dimen/ibox_home_tab_indicator_gap"
        android:background="@drawable/selector_home_tab_indicator"
        android:duplicateParentState="true" />

</androidx.appcompat.widget.LinearLayoutCompat>
