<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/tv_page_padding_top">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_empty_icon"
        android:contentDescription="@null"
        android:padding="@dimen/ibox_space_4"
        android:src="@drawable/ic_msr_movie"
        app:tint="@color/ibox_text_secondary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ibox_space_4"
        android:text="@string/error_empty"
        android:textAppearance="@style/TextAppearance.IBox.ItemTitle" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ibox_space_2"
        android:gravity="center"
        android:text="@string/empty_state_hint"
        android:textAppearance="@style/TextAppearance.IBox.Supporting" />

</androidx.appcompat.widget.LinearLayoutCompat>
