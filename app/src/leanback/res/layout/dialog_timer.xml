<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="@string/timer_description"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/ibox_text_label" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/time1"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:tag="5"
                android:text="@string/timer_5" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/time2"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:tag="15"
                android:text="@string/timer_15" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/time3"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:tag="30"
                android:text="@string/timer_30" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/time4"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:tag="60"
                android:text="@string/timer_60" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="top"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/customInput"
                style="@style/Widget.IBox.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/timer_minutes_hint"
                app:suffixText="@string/timer_minutes_suffix">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/customMinutes"
                    style="@style/Widget.IBox.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="4"
                    android:nextFocusRight="@id/customStart"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/customStart"
                style="@style/Widget.IBox.Button"
                android:layout_width="112dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@id/customMinutes"
                android:text="@string/timer_start" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_remaining"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/ibox_text_label" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:textColor="?attr/colorOnSurface"
            android:textSize="42sp"
            android:textStyle="bold"
            tools:text="25:00" />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/delay"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/timer_delay" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/timer_cancel" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
