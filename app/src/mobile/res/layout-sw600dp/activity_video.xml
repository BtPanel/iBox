<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ibox_surface_container"
    android:tag="port">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/posterBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.40"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ibox_player_scrim_soft" />

    <com.media.ibox.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/navigation">

        <View
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent" />

        <FrameLayout
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="224dp"
            android:layout_below="@+id/statusBar"
            android:background="@color/ibox_surface_container"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/videoAmbient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.40"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/videoShade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ibox_player_scrim_soft" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/player"
                style="@style/Player.Vod"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:surface_type="none" />

            <include
                android:id="@+id/widget"
                layout="@layout/view_widget_vod"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/control"
                layout="@layout/view_control_vod"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/progress"
                layout="@layout/view_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/poster"
            android:layout_width="96dp"
            android:layout_height="144dp"
            android:layout_below="@id/video"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_alignParentStart="true"
            android:background="@color/ibox_surface_variant"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_IBox_Rounded8" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:textAppearance="@style/TextAppearance.IBox.PlayerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/poster"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@id/poster"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            tools:text="慶餘年第二季" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            android:textAppearance="@style/TextAppearance.IBox.PlayerAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/name"
            android:layout_alignStart="@+id/name"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            tools:text="更新到第二季" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/site"
            android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/remark"
            android:layout_alignStart="@+id/name"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            tools:text="站源：泥巴" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/other"
            android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/site"
            android:layout_alignStart="@+id/name"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            tools:text="年份：2022 地區：台灣 類型：科幻" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/director"
            android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/other"
            android:layout_alignStart="@+id/name"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="導演：IBox" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/actor"
            android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/director"
            android:layout_alignStart="@+id/name"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="3"
            tools:text="演員：IBox" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/detail_actions"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/actor"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/danmaku_search"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/danmaku"
                app:icon="@drawable/ic_msr_search" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_player"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/nav_setting"
                app:icon="@drawable/ic_msr_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_cast"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/detail_cast"
                app:icon="@drawable/ic_msr_cast" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_download"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/download_short"
                app:icon="@drawable/ic_msr_download" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/detail_actions">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/detail_flag"
                        />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/quality_text"
                        android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/detail_quality"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_space_4"
                        android:layout_marginTop="@dimen/ibox_space_4"
                        android:layout_marginEnd="@dimen/ibox_space_4"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_episode" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ibox_space_2"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/reverse"
                                style="@style/Widget.IBox.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:insetTop="6dp"
                                android:insetBottom="6dp"
                                android:minHeight="@dimen/ibox_touch_target"
                                android:minWidth="0dp"
                                android:maxLines="2"
                                android:paddingStart="@dimen/ibox_space_2"
                                android:paddingEnd="@dimen/ibox_space_2"
                                android:singleLine="false"
                                android:textSize="@dimen/ibox_text_supporting"
                                android:visibility="gone"
                                app:icon="@drawable/ic_msr_sort"
                                app:iconPadding="@dimen/ibox_space_1"
                                app:iconSize="@dimen/ibox_icon_small"
                                tools:text="排列：正序"
                                tools:visibility="visible" />

                            <View
                                android:layout_width="@dimen/ibox_space_2"
                                android:layout_height="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/more"
                                style="@style/Widget.IBox.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:insetTop="6dp"
                                android:insetBottom="6dp"
                                android:minHeight="@dimen/ibox_touch_target"
                                android:minWidth="0dp"
                                android:maxLines="2"
                                android:paddingStart="@dimen/ibox_space_3"
                                android:paddingEnd="@dimen/ibox_space_3"
                                android:singleLine="false"
                                android:text="@string/play_all_episodes"
                                android:textSize="@dimen/ibox_text_supporting"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/content_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="16dp"
                            android:text="@string/detail_summary_title"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/content"
                            android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="8dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="4dp"
                            android:maxLines="3"
                            tools:text="一個身世神秘的少年范閒（張若昀飾），因對自身身世的好奇而離開故鄉澹州，前赴南慶京都。范閒在京中各大勢力之間遊走，以探查自己屢遭刺殺的原因。其間結識靖王世子、二皇子，與太子、長公主等人對抗，並遊歷四方、闖蕩江湖，卻意外發現這世界隱藏著的秘密。本劇第一季上半部主要描述范閒在南慶京都追查刺殺的幕後黑手，京中各式人等對范閒繼承內庫的態度和應對，以及監察院院長陳萍萍希望范閒接掌監察院所做的一切舉動。下半部劇情發生在北齊上京。南慶駐北齊上京諜報首領言冰雲被北齊官方抓獲，慶帝與陳萍萍同意用已被關在監察院大牢多年的前北魏諜報首領肖恩交換言冰雲，並派范閒親率南慶使團負責此事。" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sourceTitle"
                        android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/detail_sources"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="5"
                        tools:listitem="@layout/adapter_quick"
                        tools:visibility="visible" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.media.ibox.ui.custom.ProgressLayout>

    <include
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_navigation_height"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="8dp"
        layout="@layout/view_app_navigation" />
</RelativeLayout>
