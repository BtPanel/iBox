<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页内容源行（模板）：图标 + 标题 + 地址副标题 + 右侧两个小按钮 + 箭头。
  用于点播源 / 直播源两行，保证与通用行风格一致。
  右侧按钮（设为首页 / 订阅管理）与箭头默认显示，由代码绑定事件。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/ibox_setting_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ibox_space_4"
    android:paddingTop="@dimen/ibox_space_3"
    android:paddingEnd="@dimen/ibox_space_2"
    android:paddingBottom="@dimen/ibox_space_3">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_msr_movie"
        app:tint="@color/ibox_text_secondary" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ibox_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ibox_text_primary"
            android:textSize="@dimen/ibox_text_body"
            tools:text="@string/setting_vod" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/ibox_text_secondary"
            android:textSize="@dimen/ibox_text_supporting"
            tools:text="https://example.com/config.json" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_home"
        android:padding="10dp"
        android:src="@drawable/ic_msr_home"
        app:tint="@color/ibox_text_secondary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/history"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/repository_vod_title"
        android:padding="10dp"
        android:src="@drawable/ic_msr_rss_feed"
        app:tint="@color/ibox_text_secondary" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chevron"
        android:layout_width="@dimen/ibox_icon_small"
        android:layout_height="@dimen/ibox_icon_small"
        android:layout_marginStart="@dimen/ibox_space_1"
        android:contentDescription="@null"
        android:src="@drawable/ic_msr_chevron_right"
        app:tint="@color/ibox_text_secondary" />

</androidx.appcompat.widget.LinearLayoutCompat>
