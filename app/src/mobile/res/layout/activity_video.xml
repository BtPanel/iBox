<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ibox_surface_container"
    android:tag="port">

    <View
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/posterBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ibox_player_scrim" />

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@id/statusBar"
        android:background="@color/ibox_surface_container"
        android:clickable="true"
        android:focusable="true">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/videoAmbient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.40"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/videoShade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ibox_player_scrim_soft" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pipProgress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:max="10000"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/ibox_surface_variant"
            app:trackThickness="3dp" />
    </FrameLayout>


    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/video"
        android:layout_above="@id/navigation">

        <com.media.ibox.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/ibox_space_4">

                    <!-- 元信息：模糊海报之上的玻璃卡片 -->
                    <FrameLayout
                        android:id="@+id/metadataCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_content_padding_horizontal"
                        android:layout_marginTop="@dimen/ibox_space_3"
                        android:layout_marginEnd="@dimen/ibox_content_padding_horizontal"
                        android:background="@drawable/bg_detail_card">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ibox_space_3">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/poster"
                                    android:layout_width="96dp"
                                    android:layout_height="144dp"
                                    android:background="@color/ibox_surface_variant"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_IBox_Rounded8" />

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ibox_space_3"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/name"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textAppearance="@style/TextAppearance.IBox.PlayerTitle"
                                        tools:text="庆余年第二季" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/remark"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/ibox_space_1"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textAppearance="@style/TextAppearance.IBox.PlayerAccent"
                                        tools:text="更新至 36 集" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/other"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/ibox_space_2"
                                        android:ellipsize="end"
                                        android:lineSpacingExtra="2dp"
                                        android:maxLines="2"
                                        android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
                                        tools:text="2024 · 中国大陆 · 剧情" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/site"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/ibox_space_1"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
                                        tools:text="站源：示例源" />
                                </androidx.appcompat.widget.LinearLayoutCompat>
                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/ibox_stroke_thin"
                                android:layout_marginTop="@dimen/ibox_space_3"
                                android:background="@color/ibox_detail_card_divider" />

                            <!-- 导演/演员通栏，不再被海报挤成窄列 -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/director"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_3"
                                android:ellipsize="end"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
                                tools:text="导演：示例" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/actor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_1"
                                android:ellipsize="end"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="3"
                                android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
                                tools:text="演员：示例" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </FrameLayout>

                    <!-- 操作区：四宫格收进同一张卡片，中间用细分割线区隔 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:layout_marginStart="@dimen/ibox_content_padding_horizontal"
                        android:layout_marginTop="@dimen/ibox_space_3"
                        android:layout_marginEnd="@dimen/ibox_content_padding_horizontal"
                        android:background="@drawable/bg_detail_card"
                        android:clipToOutline="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/ibox_space_1"
                        android:paddingBottom="@dimen/ibox_space_1">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/danmaku_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/ibox_icon_medium"
                                android:layout_height="@dimen/ibox_icon_medium"
                                android:src="@drawable/ic_msr_subtitles"
                                app:tint="@color/ibox_player_text_primary" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/danmaku"
                                android:textColor="@color/ibox_player_text_secondary"
                                android:textSize="@dimen/ibox_text_caption" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <View
                            android:layout_width="@dimen/ibox_stroke_thin"
                            android:layout_height="@dimen/ibox_space_5"
                            android:background="@color/ibox_detail_card_divider" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/detail_player"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/ibox_icon_medium"
                                android:layout_height="@dimen/ibox_icon_medium"
                                android:src="@drawable/ic_msr_settings"
                                app:tint="@color/ibox_player_text_primary" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/nav_setting"
                                android:textColor="@color/ibox_player_text_secondary"
                                android:textSize="@dimen/ibox_text_caption" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <View
                            android:layout_width="@dimen/ibox_stroke_thin"
                            android:layout_height="@dimen/ibox_space_5"
                            android:background="@color/ibox_detail_card_divider" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/detail_cast"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/ibox_icon_medium"
                                android:layout_height="@dimen/ibox_icon_medium"
                                android:src="@drawable/ic_msr_cast_mobile"
                                app:tint="@color/ibox_player_text_primary" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/detail_cast"
                                android:textColor="@color/ibox_player_text_secondary"
                                android:textSize="@dimen/ibox_text_caption" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <View
                            android:layout_width="@dimen/ibox_stroke_thin"
                            android:layout_height="@dimen/ibox_space_5"
                            android:background="@color/ibox_detail_card_divider" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/detail_download"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/ibox_icon_medium"
                                android:layout_height="@dimen/ibox_icon_medium"
                                android:src="@drawable/ic_msr_download"
                                app:tint="@color/ibox_player_text_primary" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_1"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/download_short"
                                android:textColor="@color/ibox_player_text_secondary"
                                android:textSize="@dimen/ibox_text_caption" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- 线路 -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_content_padding_horizontal"
                        android:layout_marginTop="@dimen/ibox_space_5"
                        android:text="@string/detail_flag"
                        android:textAppearance="@style/TextAppearance.IBox.PlayerSection" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ibox_space_2"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/ibox_content_padding_horizontal"
                        android:paddingEnd="@dimen/ibox_content_padding_horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <!-- 清晰度 -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/quality_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_content_padding_horizontal"
                        android:layout_marginTop="@dimen/ibox_space_5"
                        android:text="@string/detail_quality"
                        android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ibox_space_2"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/ibox_content_padding_horizontal"
                        android:paddingEnd="@dimen/ibox_content_padding_horizontal"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />

                    <!-- 选集 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_content_padding_horizontal"
                        android:layout_marginTop="@dimen/ibox_space_5"
                        android:layout_marginEnd="@dimen/ibox_content_padding_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_episode"
                            android:textAppearance="@style/TextAppearance.IBox.PlayerSection" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ibox_space_2"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/reverse"
                                style="@style/Widget.IBox.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:insetTop="6dp"
                                android:insetBottom="6dp"
                                android:maxLines="2"
                                android:minHeight="@dimen/ibox_touch_target"
                                android:minWidth="0dp"
                                android:paddingStart="@dimen/ibox_space_2"
                                android:paddingEnd="@dimen/ibox_space_2"
                                android:singleLine="false"
                                android:textColor="@color/ibox_player_text_primary"
                                android:textSize="@dimen/ibox_text_supporting"
                                android:visibility="gone"
                                app:backgroundTint="@color/ibox_detail_chip_surface"
                                app:icon="@drawable/ic_msr_sort"
                                app:iconPadding="@dimen/ibox_space_1"
                                app:iconSize="@dimen/ibox_icon_small"
                                app:iconTint="@color/ibox_player_text_primary"
                                app:strokeColor="@color/ibox_detail_glass_stroke"
                                app:strokeWidth="@dimen/ibox_stroke_thin"
                                tools:text="排列：正序"
                                tools:visibility="visible" />

                            <View
                                android:layout_width="@dimen/ibox_space_2"
                                android:layout_height="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/more"
                                style="@style/Widget.IBox.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:insetTop="6dp"
                                android:insetBottom="6dp"
                                android:maxLines="2"
                                android:minHeight="@dimen/ibox_touch_target"
                                android:minWidth="0dp"
                                android:paddingStart="@dimen/ibox_space_3"
                                android:paddingEnd="@dimen/ibox_space_3"
                                android:singleLine="false"
                                android:text="@string/play_all_episodes"
                                android:textColor="@color/ibox_player_text_primary"
                                android:textSize="@dimen/ibox_text_supporting"
                                android:visibility="gone"
                                app:backgroundTint="@color/ibox_detail_chip_surface"
                                app:strokeColor="@color/ibox_detail_glass_stroke"
                                app:strokeWidth="@dimen/ibox_stroke_thin"
                                tools:visibility="visible" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ibox_space_1"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingStart="@dimen/ibox_space_3"
                        android:paddingEnd="@dimen/ibox_space_3" />

                    <!-- 简介 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/content_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ibox_space_5"
                        android:background="@android:color/transparent"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/ibox_content_padding_horizontal"
                            android:paddingEnd="@dimen/ibox_content_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_summary_title"
                                android:textAppearance="@style/TextAppearance.IBox.PlayerSection" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ibox_space_2"
                                android:ellipsize="end"
                                android:lineSpacingExtra="4dp"
                                android:maxLines="3"
                                android:textAppearance="@style/TextAppearance.IBox.PlayerSupporting"
                                tools:text="影片简介内容" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- 换源 -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sourceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ibox_content_padding_horizontal"
                        android:layout_marginTop="@dimen/ibox_space_5"
                        android:text="@string/detail_sources"
                        android:textAppearance="@style/TextAppearance.IBox.PlayerSection"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ibox_space_1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/ibox_space_2"
                        android:paddingEnd="@dimen/ibox_space_2"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="3"
                        tools:listitem="@layout/adapter_quick"
                        tools:visibility="visible" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.media.ibox.ui.custom.ProgressLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/navigation"
        layout="@layout/view_app_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_navigation_height"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
