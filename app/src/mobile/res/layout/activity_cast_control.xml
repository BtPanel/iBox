<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ibox_surface_container"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ibox_surface"
        app:navigationIconTint="@color/ibox_text_primary"
        app:title="@string/cast_control"
        app:titleTextAppearance="@style/ToolbarTextAppearance"
        app:titleTextColor="@color/ibox_text_primary" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/ibox_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cast_device_icon">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_msr_tv"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/ibox_text_primary"
                tools:text="客厅电视" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_cast_online" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/cast_connecting"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/ibox_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retry"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/cast_retry_playback"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_msr_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorPrimary" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchDevice"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cast_switch_device"
            app:icon="@drawable/ic_msr_swap_horiz"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/ibox_text_primary" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:dividerColor="@color/ibox_surface_variant" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/artwork"
                    android:layout_width="112dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_IBox_CastArtwork"
                    app:strokeColor="@color/ibox_surface_variant"
                    app:strokeWidth="2dp"
                    tools:src="@drawable/artwork" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/videoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/ibox_text_primary"
                    tools:text="示例影片名称：第一集" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.slider.Slider
                android:id="@+id/progress"
                style="@style/Widget.Material3.Slider.Legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="-8dp"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="1"
                app:haloColor="?attr/colorPrimaryContainer"
                app:haloRadius="18dp"
                app:labelBehavior="gone"
                app:thumbColor="?attr/colorPrimary"
                app:thumbRadius="6dp"
                app:trackColorActive="?attr/colorPrimary"
                app:trackHeight="4dp"
                app:trackColorInactive="@color/ibox_surface_variant" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/ibox_text_secondary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/ibox_text_secondary" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rewind"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/cast_seek_back"
                    app:icon="@drawable/ic_msr_replay_10"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/ibox_text_primary"
                    app:strokeColor="@color/ibox_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="28dp"
                    android:contentDescription="@string/cast_pause"
                    app:backgroundTint="?attr/colorPrimary"
                    app:icon="@drawable/ic_msr_pause"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="34dp"
                    app:iconTint="?attr/colorOnPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forward"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/cast_seek_forward"
                    app:icon="@drawable/ic_msr_forward_10"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/ibox_text_primary"
                    app:strokeColor="@color/ibox_outline" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/episodeGroup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previousEpisode"
                    style="@style/Widget.IBox.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/cast_previous_episode"
                    app:icon="@drawable/ic_msr_skip_previous" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextEpisode"
                    style="@style/Widget.IBox.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/cast_next_episode"
                    app:icon="@drawable/ic_msr_skip_next" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/volumeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cast_device_volume"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/ibox_text_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/volumeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="?attr/colorSecondary"
                        tools:text="50%" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_msr_volume_up"
                        app:tint="?attr/colorSecondary" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/volume"
                        style="@style/Widget.Material3.Slider.Legacy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:stepSize="1"
                        android:value="50"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:haloColor="?attr/colorPrimaryContainer"
                        app:labelBehavior="gone"
                        app:thumbColor="?attr/colorSecondary"
                        app:thumbRadius="6dp"
                        app:trackColorActive="?attr/colorSecondary"
                        app:trackHeight="4dp"
                        app:trackColorInactive="@color/ibox_surface_variant" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resumeOnPhone"
                style="@style/Widget.IBox.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/cast_resume_on_phone"
                android:visibility="gone"
                app:icon="@drawable/ic_msr_smartphone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnect"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/cast_disconnect"
                android:textColor="@color/ibox_error"
                app:icon="@drawable/ic_msr_stop_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/ibox_error"
                app:strokeColor="@color/ibox_error" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
