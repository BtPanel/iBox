<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_surface_container_high" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="?attr/focusFrameColor" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_surface_container_high" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="?attr/focusFrameColor" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_surface_container_high" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="?attr/focusFrameColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_glass_card" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/ibox_outline" />
        </shape>
    </item>
</selector>
