<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ibox_dialog_content_padding">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/movie_preference_title"
            android:textAppearance="@style/TextAppearance.IBox.DialogTitle" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/movie_preference_remember" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/movie_preference_engine"
            android:textAppearance="@style/TextAppearance.IBox.Body" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/engine"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/engineExo"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/play_exo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/engineMpv"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/play_mpv" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/movie_preference_decode"
            android:textAppearance="@style/TextAppearance.IBox.Body" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/decode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/decodeHard"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/movie_preference_hardware" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/decodeSoft"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/movie_preference_software" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/movie_preference_speed"
            android:textAppearance="@style/TextAppearance.IBox.Body" />

        <com.google.android.material.slider.Slider
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:valueFrom="0.5"
            android:valueTo="3.0"
            android:stepSize="0.25"
            app:labelBehavior="withinBounds" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/movie_preference_subtitle_style"
            android:textAppearance="@style/TextAppearance.IBox.Body" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/subtitleStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtitleOriginal"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/movie_preference_subtitle_original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtitleSystem"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/movie_preference_subtitle_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtitleCustom"
                style="@style/Widget.IBox.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/movie_preference_subtitle_custom" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/subtitleScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.IBox.Body" />

        <com.google.android.material.slider.Slider
            android:id="@+id/subtitleScale"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            android:stepSize="0.1"
            app:labelBehavior="withinBounds" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/subtitlePositionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.IBox.Body" />

        <com.google.android.material.slider.Slider
            android:id="@+id/subtitlePosition"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:valueFrom="-20"
            android:valueTo="30"
            android:stepSize="1"
            app:labelBehavior="withinBounds" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/restore"
            style="@style/Widget.IBox.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/movie_preference_restore" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
