<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="64dp"
    android:paddingVertical="40dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/code"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:contentDescription="@string/home_push"
            android:focusable="true"
            android:foreground="@drawable/selector_qr_code"
            android:padding="4dp"
            android:scaleType="fitXY" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/ibox_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/pairing_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/ibox_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/push_tools_title"
            android:textAppearance="@style/TextAppearance.IBox.Toolbar" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/push_tools_description"
            android:textColor="@color/ibox_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.IBox.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/push_link_hint"
            app:startIconDrawable="@drawable/ic_msr_search">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/link"
                style="@style/Widget.IBox.TextInputEditText.Address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:nextFocusDown="@id/play"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/play"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/push_play_link"
                android:textSize="@dimen/ibox_text_button"
                app:autoSizeTextType="none"
                app:icon="@drawable/ic_msr_play_arrow" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clip"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:text="@string/push_clip"
                android:textSize="@dimen/ibox_text_button"
                app:autoSizeTextType="none" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/choose"
                style="@style/Widget.IBox.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/push_choose_file"
                android:textSize="@dimen/ibox_text_button"
                app:autoSizeTextType="none"
                app:icon="@drawable/ic_msr_folder" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
