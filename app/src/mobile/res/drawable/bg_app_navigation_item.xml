<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="@dimen/ibox_space_2" android:insetRight="@dimen/ibox_space_2"
            android:insetTop="@dimen/ibox_space_1" android:insetBottom="@dimen/ibox_space_1">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorPrimary" />
                <corners android:radius="@dimen/ibox_radius_pill" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="@dimen/ibox_space_2" android:insetRight="@dimen/ibox_space_2"
            android:insetTop="@dimen/ibox_space_1" android:insetBottom="@dimen/ibox_space_1">
            <shape android:shape="rectangle">
                <solid android:color="@color/ibox_interaction_pressed" />
                <corners android:radius="@dimen/ibox_radius_pill" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="@dimen/ibox_space_2" android:insetRight="@dimen/ibox_space_2"
            android:insetTop="@dimen/ibox_space_1" android:insetBottom="@dimen/ibox_space_1">
            <shape android:shape="rectangle">
                <solid android:color="@color/ibox_interaction_pressed" />
                <corners android:radius="@dimen/ibox_radius_pill" />
            </shape>
        </inset>
    </item>
    <item android:state_hovered="true">
        <inset android:insetLeft="@dimen/ibox_space_2" android:insetRight="@dimen/ibox_space_2"
            android:insetTop="@dimen/ibox_space_1" android:insetBottom="@dimen/ibox_space_1">
            <shape android:shape="rectangle">
                <solid android:color="@color/ibox_interaction_pressed" />
                <corners android:radius="@dimen/ibox_radius_pill" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="@dimen/ibox_space_2" android:insetRight="@dimen/ibox_space_2"
            android:insetTop="@dimen/ibox_space_1" android:insetBottom="@dimen/ibox_space_1">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <corners android:radius="@dimen/ibox_radius_pill" />
            </shape>
        </inset>
    </item>
</selector>
