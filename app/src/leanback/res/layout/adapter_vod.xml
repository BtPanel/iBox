<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_vod">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/ibox_surface_variant"
        app:shapeAppearanceOverlay="@style/Vod.Grid" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:layout_alignTop="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:layout_alignBottom="@+id/name"
        android:background="@color/ibox_player_scrim_soft"
        android:scaleType="center"
        android:src="@drawable/ic_vod_delete"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/Vod.Grid.Large"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_vod_year"
        android:singleLine="true"
        android:textColor="@color/ibox_player_text_primary"
        android:textSize="@dimen/ibox_text_supporting"
        android:visibility="gone"
        tools:text="2022"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_vod_site"
        android:singleLine="true"
        android:textColor="@color/ibox_player_text_primary"
        android:textSize="@dimen/ibox_text_supporting"
        android:visibility="gone"
        tools:text="泥巴"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/name"
        android:layout_marginBottom="4dp"
        android:background="@drawable/shape_vod_remark"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:textColor="@color/ibox_player_text_primary"
        android:textSize="@dimen/ibox_text_supporting"
        tools:text="1080p" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:background="@color/ibox_surface_variant"
        app:indicatorColor="@color/ibox_primary"
        app:trackColor="@color/transparent"
        app:trackStopIndicatorSize="0dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        style="@style/Widget.IBox.PosterTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_vod_name_height"
        android:layout_alignStart="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:background="@drawable/shape_vod_name"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        tools:text="蜘蛛人" />

</RelativeLayout>
