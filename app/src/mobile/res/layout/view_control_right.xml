<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/right"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/lock"
        android:layout_width="@dimen/ibox_icon_action_size"
        android:layout_height="@dimen/ibox_icon_action_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_msr_lock_open" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rotate"
        android:layout_width="@dimen/ibox_icon_action_size"
        android:layout_height="@dimen/ibox_icon_action_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_toggle_orientation"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_msr_screen_rotation"
        android:tooltipText="@string/play_toggle_orientation" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pip"
        android:layout_width="@dimen/ibox_icon_action_size"
        android:layout_height="@dimen/ibox_icon_action_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_picture_in_picture"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_msr_picture_in_picture_alt"
        android:tooltipText="@string/play_picture_in_picture" />

</androidx.appcompat.widget.LinearLayoutCompat>
