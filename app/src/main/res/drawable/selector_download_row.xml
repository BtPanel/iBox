<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_surface" />
            <corners android:radius="@dimen/ibox_radius_card" />
            <stroke android:width="@dimen/ibox_focus_stroke" android:color="?attr/focusFrameColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ibox_surface" />
            <corners android:radius="@dimen/ibox_radius_card" />
            <stroke android:width="1dp" android:color="@color/ibox_outline" />
        </shape>
    </item>
</selector>
