<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ibox_setting_row_height">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:contentInsetEnd="@dimen/ibox_space_1"
            app:contentInsetStartWithNavigation="@dimen/ibox_space_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/menu_search"
            app:navigationIconTint="@color/ibox_text_primary" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/ibox_touch_target"
            android:layout_marginStart="@dimen/ibox_toolbar_height"
            android:layout_marginEnd="@dimen/ibox_toolbar_height"
            android:background="@drawable/bg_search_input"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/ibox_icon_small"
                android:layout_height="@dimen/ibox_icon_small"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/ibox_space_4"
                android:contentDescription="@null"
                android:src="@drawable/ic_msr_search"
                app:tint="@color/ibox_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/keyword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:dropDownHeight="0dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hint="@string/search_page_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
                android:maxLength="255"
                android:paddingStart="@dimen/ibox_touch_target"
                android:paddingEnd="@dimen/ibox_touch_target"
                android:singleLine="true"
                android:textColor="@color/ibox_text_primary"
                android:textColorHint="@color/ibox_text_secondary"
                android:textAppearance="@style/TextAppearance.IBox.Body"
                tools:hint="搜索电影 / 剧集 / 演员" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/keywordClear"
                android:layout_width="@dimen/ibox_touch_target"
                android:layout_height="@dimen/ibox_touch_target"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="0dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dialog_negative"
                android:padding="@dimen/ibox_space_3"
                android:src="@drawable/ic_msr_close"
                app:tint="@color/ibox_text_secondary"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/scope"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ibox_touch_target"
        android:layout_marginHorizontal="@dimen/ibox_space_4"
        android:layout_marginTop="@dimen/ibox_space_2"
        android:layout_marginBottom="@dimen/ibox_space_1"
        app:checkedButton="@id/scopeAll"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scopeAll"
            style="@style/Widget.IBox.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ibox_touch_target"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="@dimen/ibox_space_4"
            android:paddingEnd="@dimen/ibox_space_4"
            android:text="@string/search_scope_all"
            android:textColor="@color/selector_scope_text"
            app:backgroundTint="@color/selector_scope_bg"
            app:rippleColor="@color/ibox_glass_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scopeCurrent"
            style="@style/Widget.IBox.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ibox_touch_target"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:maxLines="1"
            android:paddingStart="@dimen/ibox_space_4"
            android:paddingEnd="@dimen/ibox_space_4"
            android:text="@string/search_scope_all"
            android:textColor="@color/selector_scope_text"
            app:backgroundTint="@color/selector_scope_bg"
            app:rippleColor="@color/ibox_glass_divider" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:id="@+id/content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ibox_space_3"
            android:paddingTop="@dimen/ibox_space_2"
            android:paddingEnd="@dimen/ibox_space_3"
            android:paddingBottom="@dimen/ibox_space_5">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/record"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ibox_touch_target"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginEnd="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_record"
                    android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyClear"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="@dimen/ibox_touch_target"
                    android:layout_height="@dimen/ibox_touch_target"
                    android:contentDescription="@string/search_history_clear"
                    app:icon="@drawable/ic_msr_delete"
                    app:iconTint="@color/ibox_text_secondary" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recordRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/ibox_space_2"
                tools:itemCount="5"
                tools:listitem="@layout/adapter_search_record" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ibox_space_1"
                android:layout_marginEnd="@dimen/ibox_space_1"
                android:layout_marginBottom="@dimen/ibox_space_2"
                android:text="@string/search_hot"
                android:textAppearance="@style/TextAppearance.IBox.SectionLabel" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wordRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/ibox_space_1"
                tools:itemCount="5"
                tools:listitem="@layout/adapter_search_word" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
